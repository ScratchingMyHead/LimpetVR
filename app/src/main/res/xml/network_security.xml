<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (plain http) is permitted: the in-app web browser has to
     follow http:// redirects, which a surprising number of sites still
     serve (and a failing one just shows "Webpage not available").
     The loopback entry is the SMB stream proxy for ExoPlayer. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
