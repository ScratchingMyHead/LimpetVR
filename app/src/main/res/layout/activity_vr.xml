<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000" android:keepScreenOn="true">
    <com.google.vr.sdk.base.GvrView
        android:id="@+id/glView"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <!-- Web mode: the page lives here at 1600x900 and is copied into a GL
         texture (PixelCopy) for the flat screen. It stays visible on the
         phone screen as a mirror; inside the headset you never see it. -->
    <FrameLayout
        android:id="@+id/webHost"
        android:layout_width="1600px" android:layout_height="900px"
        android:layout_gravity="center" />
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="30dp" android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/close_button_bg"
        android:gravity="center"
        android:text="✕" android:textSize="16sp"
        android:textColor="#fff" />
    <TextView android:id="@+id/txtStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
