<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000" android:keepScreenOn="true">
    <com.google.vr.sdk.base.GvrView
        android:id="@+id/glView"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <!-- Web mode: the page lives here and is copied into a GL texture
         (PixelCopy) for the flat screen. It stays visible on the phone
         screen as a mirror; inside the headset you never see it.

         1440x900 (16:10), not 16:9: the content area is only 900px tall
         (the display cutout and nav bar take the rest), so height is the
         binding constraint. At a fixed 1280px CSS viewport a taller aspect
         costs FEWER pixels to read back, not more - 1.30M against 1.44M -
         and gives the page more vertical room, so there is less scrolling. -->
    <FrameLayout
        android:id="@+id/webHost"
        android:layout_width="1440px" android:layout_height="900px"
        android:layout_gravity="center" />
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="30dp" android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/close_button_bg"
        android:gravity="center"
        android:text="✕" android:textSize="16sp"
        android:textColor="#fff" />
    <TextView android:id="@+id/txtStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
